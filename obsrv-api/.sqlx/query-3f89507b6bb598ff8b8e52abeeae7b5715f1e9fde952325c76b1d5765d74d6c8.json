  "query": "\n        SELECT date::text as \"date!\", call_count, failed_count, avg_cu, peak_cu\n        FROM instruction_daily\n        WHERE program_id = $1\n          AND instruction_type = $2\n          AND date::date >= CURRENT_DATE - INTERVAL '7 days'\n        ORDER BY date ASC\n        ",
