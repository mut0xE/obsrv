  "query": "\n            SELECT id, signature, slot, block_time, fee_payer, fee_lamports,\n                   tx_type, source, description, success, error,\n                   native_transfers, token_transfers, account_data,\n                   instructions, events, created_at\n            FROM webhook_transactions\n            WHERE fee_payer = $1\n            ORDER BY created_at DESC\n            LIMIT $2 OFFSET $3\n            ",
