  "query": "\n        SELECT id, signature, slot, wallet, risk_score, execution_status,\n               failure_reason, cu_consumed, fee_lamports, is_durable_nonce,\n               programs_called, block_time, created_at\n        FROM forensics_history\n        WHERE wallet = $1\n        ORDER BY created_at DESC\n        LIMIT 100\n        ",
